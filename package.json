{
  "name": "claude-fast",
  "private": true,
  "version": "1.0.0",
  "description": "一键在项目目录启动 Claude Code 的桌面应用",
  "author": "laphere",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:vite": "vite",
    "typecheck": "npm run typecheck:web && npm run typecheck:electron",
    "typecheck:web": "tsc",
    "typecheck:electron": "tsc -p electron/tsconfig.json",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node tools/build-electron.mjs",
    "start": "electron .",
    "electron:dev": "npm run dev",
    "electron:build": "npm run dist:win",
    "dist": "npm run build && electron-builder --win --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.claudefast.launcher",
    "productName": "Claude助手",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/claude-agent-sdk*/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/128x128@2x.png",
        "to": "icon128.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "artifactName": "Claude助手_${version}_x64-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    }
  }
}
